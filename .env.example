# 后端运行环境（必填），可选 development 或 production。仅 development 开放接口文档和调试日志。
ENV=

# 后端监听 IP（必填），本机开发常用 127.0.0.1，容器内常用 0.0.0.0。
HOST=

# 后端监听端口（必填），本机开发常用 8000，范围 1–65535。
PORT=

# PostgreSQL 连接地址（必填），例如 postgresql+asyncpg://user:password@db.example.com:5432/authcenter。
DATABASE_URL=

# Redis 连接地址（必填），例如 redis://:password@redis.example.com:6379/0，TLS 使用 rediss://。
REDIS_URL=

# 日志级别，默认 info。仅 development 可使用 debug。
# LOG_LEVEL=info
