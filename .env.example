# 后端运行环境（必填），可选 development 或 production
ENV=

# PostgreSQL 连接地址（必填），例如 postgresql+asyncpg://postgres:123456@localhost:5432/auth_center
DATABASE_URL=

# Redis 连接地址（必填），例如 redis://:123456@localhost:6379/0，TLS 使用 rediss://
REDIS_URL=

# 应用日志级别（必填），可选 ERROR、WARNING、INFO、DEBUG。仅 development 可使用 DEBUG
LOG_LEVEL=INFO
