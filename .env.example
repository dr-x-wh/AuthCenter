# 后端运行环境（必填），可选 development 或 production。仅 development 开启调试。
BACKEND_ENV=

# 后端监听 IP（必填），本机开发常用 127.0.0.1，容器内常用 0.0.0.0。
UVICORN_HOST=

# 后端监听端口（必填），本机开发常用 8000，范围 1–65535。
UVICORN_PORT=

# PostgreSQL 连接地址（必填），例如 postgresql+asyncpg://user:password@db.example.com:5432/authcenter。
DATABASE_URL=

# Redis 连接地址（必填），例如 redis://user:password@redis.example.com:6379/0，TLS 使用 rediss://。
REDIS_URL=

# OpenAPI 文档显示的服务名称，默认 AuthCenter，例如 AuthCenter API。
# APP_NAME=AuthCenter

# 应用和 Uvicorn 日志级别，默认 info，排查问题时可设为 debug。
# UVICORN_LOG_LEVEL=info
